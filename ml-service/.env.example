# Keycloak - obtained from Track A's Keycloak realm config
KEYCLOAK_ISSUER=https://auth.internal/realms/airport
KEYCLOAK_AUDIENCE=ml-service

# Shared Postgres (same DB as the backend, different least-privilege role)
DATABASE_URL=postgresql://ml_service_ro:changeme@postgres:5432/airport_tracking

# Comma-separated list of allowed origins - the deployed frontend URL(s) only
ALLOWED_ORIGINS=https://dashboard.internal
MODEL_DIR=/data/models
